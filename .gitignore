# -----------------------------------------------------------------------------
# Dependency managers (keep the LOCK files — they pin your baseline)
# -----------------------------------------------------------------------------
.bender/
.fusesoc/
fusesoc_cache/
# Explicitly track the lock files:
!Bender.lock
!*.lock


# -----------------------------------------------------------------------------
# Python — automation, reference models, telemetry analysis
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/

# Virtual environments
.venv/
venv/
env/
ENV/
.python-version

# Testing and linting
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.mypy_cache/
.ruff_cache/
.dmypy.json

# Jupyter
.ipynb_checkpoints/
*-checkpoint.ipynb

# Keep requirements.txt / pyproject.toml tracked (not listed = tracked)


# -----------------------------------------------------------------------------
# Large data — plots and CSVs under 1 MB are fine to track; raw traces are not
# -----------------------------------------------------------------------------
*.h5
*.hdf5
*.npy
*.npz
*.pkl
*.parquet
traces_raw/
*.trace


# -----------------------------------------------------------------------------
# Editors and OS
# -----------------------------------------------------------------------------
.vscode/
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.\#*
\#*\#
.DS_Store
Thumbs.db
desktop.ini


# -----------------------------------------------------------------------------
# Secrets and licensing — never commit these
# -----------------------------------------------------------------------------
.env
.env.*
*.pem
*.key
license.dat
LM_LICENSE_FILE
*.lic


# =============================================================================
# Evidence — explicitly TRACKED
#
# The plan makes archived logs, coverage reports and benchmark data part of
# the release evidence package. The negations below override the broad
# patterns above so that curated evidence still gets committed.
#
# Note: a negation cannot rescue a file whose parent DIRECTORY is ignored,
# so keep evidence in results/ and docs/ rather than inside work/ or runs/.
# =============================================================================
!results/
!results/**
!docs/
!docs/**
!analysis/**/*.csv
!analysis/**/*.png
!analysis/**/*.svg
!**/coverage_report/**
!**/*.evidence.log
!**/gate_review*.md