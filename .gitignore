# =============================================================================
# QoS-Aware Data Movement Subsystem — .gitignore
#
# Principle: ignore regenerable build artifacts, keep evidence.
# Simulator logs, coverage reports and benchmark results are part of the
# release evidence package, so they are NOT blanket-ignored. See the
# "Evidence" section at the bottom for the explicit keep rules.
# =============================================================================


# -----------------------------------------------------------------------------
# Simulator work libraries and transcripts
# -----------------------------------------------------------------------------

# Questa / ModelSim
work/
*_work/
transcript
transcript.*
vsim.dbg
vsim_stacktrace.vstf
vish_stacktrace.vstf
modelsim.ini
.modelsim
*.mti
*.mpf
vmake.log
vlog.log
vcom.log
vopt.log
vsim.log

# Synopsys VCS
simv
simv.daidir/
csrc/
ucli.key
vc_hdrs.h
.vcs_lib_lock
AN.DB/
DVEfiles/
*.vpd
novas.*
verdiLog/

# Cadence Xcelium / Incisive
xcelium.d/
INCA_libs/
xrun.history
xrun.log
xmelab.log
xmsim.log
irun.log
.simvision/
waves.shm/

# Aldec Riviera-PRO / Active-HDL
rivierapro.log
compile.out
library.cfg
*.lib/

